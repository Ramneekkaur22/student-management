generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}



model Student{
  id Int @id @default(autoincrement())
  name String
  email String @unique
  course String
  age Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
